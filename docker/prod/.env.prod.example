# Plan 11a / D11 + GC2 — the shape of the PRODUCTION environment file. PLACEHOLDERS ONLY.
#
# NO SECRET EVER ENTERS THIS FILE OR ANY OTHER FILE IN GIT. Copy it to the deploy directory,
# fill it in there, and lock it down:
#
#     cp docker/prod/.env.prod.example /opt/hmis-prod/.env
#     chmod 600 /opt/hmis-prod/.env
#
# deploy.sh refuses to run unless /opt/hmis-prod/.env exists and is mode 600.
#
# INTERPOLATION WARNING: compose expands `$` in this file. A password containing a literal `$`
# must be written `$$`. Generating passwords as hex or base64url avoids the question entirely.

# --- database -------------------------------------------------------------------------------
# The `db` service on the compose network, NOT 127.0.0.1:5434 — that publication exists for
# operators and for T4's backup tooling, not for the application.
DATABASE_URL=postgres://hmis:REPLACE_WITH_DB_PASSWORD@db:5432/hmis
POSTGRES_USER=hmis
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
POSTGRES_DB=hmis

# --- the application ------------------------------------------------------------------------
PORT=3000

# D11 / spec E-2 — THE SECRET_KEY CEREMONY. 32 bytes of hex, generated ON THE BOX, never in git,
# never in a report, never in a chat message:
#
#     openssl rand -hex 32
#
# Paste the output after the `=` below in /opt/hmis-prod/.env (not here), chmod 600, and escrow
# it by the printed procedure in the runbook (T6). Losing it makes every existing session and
# every value sealed with it unrecoverable; leaking it is a full compromise.
SECRET_KEY=

# --- backups (T4, pgBackRest → S3-compatible object storage) ----------------------------------
# Ruling 3 keeps this PROTOCOL-shaped, never provider-shaped: stage 3 re-points these five keys
# at MinIO on the NAS and changes nothing else. On this box the live values are kept in a
# separate root-only file (/opt/hmis-prod/.env.r2) and are not duplicated here.
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- retention (T5, D6/D7) --------------------------------------------------------------------
# ALL THREE ARE OPTIONAL AND ALL THREE HAVE SAFE DEFAULTS IN `config.ts`. They are written out
# here — commented, at their shipped defaults — because a key that exists and is invisible is the
# `NOTIFY_STUCK_AFTER_MS` scar (plan-10 gate report §7.2): an operator who cannot see a setting
# cannot reason about it, and the one setting on this list deletes clinical records.
#
# LEAVE `RETENTION_ENABLED` FALSE UNTIL COUNSEL HAS SIGNED THE WINDOW (ruling 6). The mechanism
# ships INERT on purpose: with it false the sweep runs, finds its work, and deletes nothing.
# Read the runbook's "Retention" section before you change it — in particular, understand how to
# place a legal hold BEFORE you enable deletion, not after.
#
# RETENTION_ENABLED=false
#
# Whole months of `events` older than this are DROPPED as partitions, never deleted row by row.
# The DEFAULT partition and the current and adjacent months are never dropped whatever this says.
# 120 months = 10 years.
# RETENTION_EVENTS_MONTHS=120
#
# Terminal `notifications` rows (sent · expired · suppressed · undeliverable) older than this are
# pruned in bounded batches. `queued` and `sending` are NEVER pruned at any age (GC6): a `sending`
# row is the only record that a message may already be with a patient.
# NOTIFY_RETAIN_DAYS=180
