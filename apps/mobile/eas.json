{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "env": { "APP_ENV": "development" },
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_ENV": "preview" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false, "node": "22.23.2" }
    },
    "production": {
      "env": { "APP_ENV": "production" },
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "ios": { "distribution": "store", "node": "22.23.2" }
    }
  },
  "submit": { "production": { "ios": { "bundleIdentifier": "com.crkmch.hmis", "appName": "HMIS Staff" } } }
}
