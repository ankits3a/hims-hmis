# Copy to apps/core/.env (git-ignored; chmod 600 on the server). Existing env vars always win.
DATABASE_URL=postgres://hmis:hmis@localhost:5433/hmis_dev
TEST_DATABASE_URL=postgres://hmis:hmis@localhost:5433/hmis_test
# 32 bytes hex. Generate: openssl rand -hex 32
# Dev/test key only — the production key is generated and escrowed in Plan 11 (spec E-2).
SECRET_KEY=
PORT=3000
SESSION_TTL_MINUTES=720
SECOND_FACTOR_WINDOW_MINUTES=5
BADGE_MAX_AGE_DAYS=365
BREAK_GLASS_TTL_MINUTES=60
TEMP_ROLE_MAX_TTL_MINUTES=720
# Used only by scripts/seed-admin.ts and scripts/create-agent.ts:
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
AGENT_NAME=

# ── FD-8/FD-11 · the triage advisor's LLM gateway ────────────────────────────────────────────────
# ALL OPTIONAL. With no key the counter routes on its own keyword table and never makes a network
# call — that is the shipped default and what every test sees. The call is server-side only: the key
# must never reach the browser bundle.
#
# The client is OpenAI-shaped, so any OpenAI-compatible gateway works. The owner moved this off
# Omniroute (measured 22-40 s, and it returned SSE even for stream:false) to Groq (measured 478 ms
# median on the real triage prompt).
#
# TRIAGE_MODEL must be a model THIS ACCOUNT OFFERS — check `GET /v1/models` rather than the vendor's
# published list. Groq's docs lead with llama-3.3-70b-versatile, which our account does not carry.
TRIAGE_BASE_URL=https://api.groq.com/openai/v1
TRIAGE_API_KEY=
TRIAGE_MODEL=openai/gpt-oss-120b
TRIAGE_TIMEOUT_MS=6000
# Triage's FIRST model since 2026-09-19: TypeSafe, with the chat model above as its fallback. Optional;
# shown commented because an EMPTY key fails the config at boot. The model is a pinned version.
# TRIAGE_TYPESAFE_API_KEY=
# TRIAGE_TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# TRIAGE_TYPESAFE_MODEL=jev-1.13.0
# TRIAGE_TYPESAFE_TIMEOUT_MS=1000
# TRIAGE_TYPESAFE_MIN_CONFIDENCE=0.6

# ── The desk copilot's router: TypeSafe FIRST, the chat model its fallback (owner, 2026-09-19) ──
# All optional, and shown commented: an EMPTY key fails the config's min(1) at boot, so a key line
# is either filled or absent. With neither key set the copilot answers from its phrasebook alone.
# TypeSafe is a classifier: it is handed the tool menu and returns one tool (or "none") with a
# confidence. Below COPILOT_TYPESAFE_MIN_CONFIDENCE, or on any failure, the chat model is asked.
# The model is a pinned VERSION — the confidence line was measured against it; re-measure to move.
# COPILOT_TYPESAFE_API_KEY=
# COPILOT_TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# COPILOT_TYPESAFE_MODEL=jev-1.13.0
# COPILOT_TYPESAFE_TIMEOUT_MS=1000
# COPILOT_TYPESAFE_MIN_CONFIDENCE=0.6
# The fallback: any OpenAI-compatible gateway, same shape as TRIAGE_* above.
# COPILOT_BASE_URL=https://api.groq.com/openai/v1
# COPILOT_API_KEY=
# COPILOT_MODEL=openai/gpt-oss-120b
# COPILOT_TIMEOUT_MS=3000

# --- ABDM (ABHA / Health Information Exchange) — OFF until every required key is set -----------
# Plan docs/superpowers/plans/2026-09-25-abdm-connector.md. With any of the five REQUIRED keys empty
# the connector is off: the counter records a self-declared ABHA and every ABDM route answers 503.
# The client id and secret are issued by ABDM to the hospital; the SECRET lives only in this file
# (never in git, a log, a table or a chat). Once set, register the callback URL ONCE with
#     pnpm --filter @hmis/core exec tsx scripts/abdm-register-bridge.ts
# REQUIRED:
# ABDM_BASE_URL=https://dev.abdm.gov.in/api/hiecm          # the gateway; production https://apis.abdm.gov.in/api/hiecm
# ABDM_CLIENT_ID=
# ABDM_CLIENT_SECRET=
# ABDM_HIP_ID=                                             # the hospital's HFR facility id
# ABDM_CALLBACK_BASE_URL=https://<host>/api/abdm/callbacks
# OPTIONAL:
# ABDM_CM_ID=sbx                                           # sbx (sandbox) | abdm (production)
# ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api  # the ABHA (M1) API, used from S1
# ABDM_HIU_ID=
# ABDM_JWT_AUDIENCE=account                                # UNVERIFIED — confirm on the sandbox portal
# S1 (ABHA at the counter). Verifying an existing ABHA is ON whenever ABDM and ABDM_ABHA_BASE_URL are set.
# ABDM_ABHA_CREATE_AADHAAR=false                          # true ONLY after the owner rules on Aadhaar-OTP creation
# ABDM_SANDBOX_OTP_TO_LOG=false                           # sandbox FT window only: writes the linking OTP to the server log
# ABDM_SCAN_SHARE_URL=                                    # empty: https://phrsbx.abdm.gov.in/share-profile (sbx) / https://phr.abdm.gov.in/share-profile (abdm);
#                                                         # or a template with {hipId} and {counterId} — UNVERIFIED, confirm on the sandbox
# S2 (the hospital as HIP). How a request matching a GRANTED consent is released: auto (DECIDED default —
# exactly what the consent allows, every release logged) | manual (acknowledged and held; the review step is owed).
# ABDM_CONSENT_RELEASE=auto
