      "uoms": [{ "uom": "tablet", "toBaseMultiplier": 1 }, { "uom": "strip", "toBaseMultiplier": 10 }],
      "batch": { "mrpPaise": 12000, "mrpUom": "strip" },
      "regulation": null,
      "taxRateBps": 0,
      "expect": { "batchUnitPaise": 1200, "capUnitPaise": 1200, "winner": "batch_mrp", "mrpPaisePerBase": 1200, "ceilingPaisePerBase": null, "ceilingInclusivePaisePerBase": null }
    },
    {
